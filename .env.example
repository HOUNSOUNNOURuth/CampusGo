# Copier ce fichier en ".env.local" et remplir les valeurs réelles.
# Ne JAMAIS committer le fichier .env.local (il est dans .gitignore).

# --- Supabase ---
# Trouvables dans Supabase > Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Chariow ---
# IMPORTANT : la clé secrète Chariow ne doit JAMAIS être mise dans le frontend
# (donc jamais dans une variable VITE_...). Elle vit uniquement côté serveur,
# dans les secrets de la Supabase Edge Function (voir supabase/functions).
# Ici on ne garde que ce qui peut être exposé au navigateur si besoin :
VITE_CHARIOW_STORE_SLUG=campusgo
